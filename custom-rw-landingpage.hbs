<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Runners Weather – Know when to run, and what to wear</title>
    <meta name="description" content="Dew point, wind, rain and feels-like temps, turned into one clear answer for every hour of your day. Free on iPhone and Android.">
    {{ghost_head}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap">
    <style>
        :root {
            --ink: #16222B;
            --ink-2: #3D4A54;
            --ink-3: #5A6670;
            --ground: #FBF8F3;
            --line: #E7E1D6;
            --peach: #F4D9BF;
            --orange: #E8772E;
            --orange-dark: #A8501A;
            --blue: #2F6E99;
            --green: #2E6B3A;
            --wrap: 1200px;
            --gutter: clamp(20px, 5vw, 64px);
        }

        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--ground);
            color: var(--ink);
            font-family: Inter, system-ui, -apple-system, sans-serif;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3 { font-family: 'Space Grotesk', Inter, sans-serif; margin: 0; }
        p { margin: 0; }
        img { max-width: 100%; }
        a { color: var(--ink); }
        a:hover { color: var(--orange-dark); }

        .wrap { max-width: var(--wrap); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
        .section { padding-top: clamp(56px, 8vw, 112px); padding-bottom: clamp(56px, 8vw, 112px); }
        .eyebrow { font-size: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--orange-dark); }
        .h2 { font-size: clamp(34px, 4vw, 52px); line-height: 1.08; letter-spacing: -0.02em; font-weight: 700; }
        .lead { font-size: 17px; line-height: 1.6; color: var(--ink-2); }

        /* Header */
        .site-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 20px; padding-bottom: 20px; }
        .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .brand img { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; }
        .brand span { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; color: var(--ink); }
        .main-nav { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; font-size: 15px; font-weight: 500; }
        .main-nav a { text-decoration: none; padding: 12px 0; }
        .main-nav .nav-cta { padding: 12px 20px; border-radius: 999px; background: var(--ink); color: #fff; }
        .main-nav .nav-cta:hover { background: #2a3a45; color: #fff; }

        /* Store badges */
        .badges { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
        .badges a { display: block; line-height: 0; }
        .badge-apple { height: 56px; width: auto; }
        /* Google's badge PNG has built-in transparent padding; scale it up so it matches the Apple badge */
        .badge-google { height: 83px; width: auto; margin: -13.5px -10px; }

        /* Hero */
        .hero { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(40px, 6vw, 96px); padding-top: clamp(32px, 6vw, 88px); padding-bottom: clamp(48px, 7vw, 104px); }
        .hero-text { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
        .pill { display: inline-flex; align-self: flex-start; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: 14px; font-weight: 500; color: var(--ink-2); }
        .pill-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); }
        .hero h1 { font-size: clamp(44px, 6vw, 76px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 700; }
        .hero-sub { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: var(--ink-2); max-width: 34ch; }
        .hero-note { font-size: 14px; color: var(--ink-3); }
        .hero-phone { flex: 0 1 340px; min-width: 260px; display: flex; justify-content: center; position: relative; }
        .hero-phone::before { content: ""; position: absolute; inset: 8% -6% -4% -6%; border-radius: 48px; background: var(--peach); }
        .phone { position: relative; width: 100%; max-width: 320px; padding: 10px; border-radius: 52px; background: var(--ink); box-shadow: 0 30px 60px rgba(22, 34, 43, 0.25); }
        .phone img { display: block; width: 100%; height: auto; border-radius: 42px; }

        /* Dew point */
        .dark { background: var(--ink); color: #fff; }
        .dew-head { display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: flex-end; justify-content: space-between; margin-bottom: 48px; }
        .dew-head > div { flex: 1 1 420px; display: flex; flex-direction: column; gap: 16px; }
        .dark .eyebrow { color: #F2A66B; }
        .dew-head p.copy { flex: 1 1 360px; font-size: 18px; line-height: 1.6; color: #C9D2D8; }
        .bands { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
        .band { display: flex; flex-direction: column; gap: 10px; padding: 20px; border-radius: 16px; color: var(--ink); }
        .band b { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; }
        .band span { font-size: 15px; font-weight: 600; }
        .band.light { color: #fff; }
        .dew-foot { margin-top: 24px; font-size: 13px; color: #9AA7B0; }

        /* Features */
        .features-head { display: flex; flex-direction: column; gap: 16px; max-width: 640px; margin-bottom: 48px; }
        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
        .card { display: flex; flex-direction: column; gap: 20px; padding: 28px; border-radius: 24px; background: #fff; border: 1px solid var(--line); }
        .card h3 { font-size: 22px; font-weight: 700; }
        .card > p { font-size: 16px; line-height: 1.6; color: var(--ink-2); }
        .mini { display: flex; flex-direction: column; gap: 12px; padding: 20px; border-radius: 16px; }
        .mini-label { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; }
        .mini-blue { background: #EEF4F8; } .mini-blue .mini-label { color: var(--blue); }
        .mini-peach { background: #FBEFE3; } .mini-peach .mini-label { color: var(--orange-dark); }
        .mini-green { background: #F1F3EE; gap: 4px; } .mini-green .mini-label { color: #44663A; padding-bottom: 6px; }
        .mini-big { font-family: 'Space Grotesk', sans-serif; font-size: 26px; font-weight: 700; }
        .mini-small { font-size: 13px; color: var(--ink-2); }
        .bars { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 4px; align-items: end; height: 56px; }
        .bars i { display: block; border-radius: 4px; background: #B8CDDC; }
        .bars i.best { background: var(--blue); }
        .wear-item { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500; }
        .hour { display: grid; grid-template-columns: 56px 44px 1fr; align-items: center; gap: 8px; padding: 6px 0; font-size: 14px; border-top: 1px solid #DDE2D8; }
        .hour .t { color: var(--ink-3); }
        .hour .v { font-weight: 600; }
        .hour .d { display: flex; align-items: center; gap: 8px; color: var(--ink-2); }
        .dot { width: 10px; height: 10px; border-radius: 50%; flex: none; }
        .extras { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-top: 48px; }
        .extra { display: flex; flex-direction: column; gap: 8px; padding: 20px 0; border-top: 2px solid var(--ink); }
        .extra h3 { font-size: 18px; font-weight: 700; }
        .extra p { font-size: 15px; line-height: 1.55; color: var(--ink-2); }

        /* Platforms */
        .platforms-band { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
        .platforms { display: flex; flex-wrap: wrap; gap: 48px; }
        .platforms-text { flex: 1 1 320px; display: flex; flex-direction: column; gap: 16px; }
        .platforms-text .h2 { font-size: clamp(32px, 3.6vw, 46px); line-height: 1.1; }
        .table-box { flex: 1.4 1 460px; min-width: 0; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 15px; }
        thead th { padding: 12px 8px; font-weight: 600; text-align: center; border-bottom: 2px solid var(--ink); }
        thead th:first-child { padding-left: 0; text-align: left; color: var(--ink-3); }
        tbody th { padding: 14px 0; text-align: left; font-weight: 500; border-bottom: 1px solid var(--line); }
        tbody td { padding: 14px 8px; text-align: center; font-weight: 600; color: var(--green); border-bottom: 1px solid var(--line); }
        tbody td.no { color: #7A858D; }

        /* Closing panel */
        .closing { display: flex; flex-wrap: wrap; align-items: center; gap: 32px 56px; padding: clamp(32px, 5vw, 64px); border-radius: 32px; background: var(--peach); }
        .closing > img { width: 120px; height: 120px; border-radius: 28px; object-fit: cover; box-shadow: 0 16px 32px rgba(22, 34, 43, 0.18); }
        .closing h2 { flex: 1 1 380px; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; letter-spacing: -0.02em; font-weight: 700; }
        .closing .badge-apple { height: 52px; }
        .closing .badge-google { height: 77px; margin: -12.5px -9px; }

        /* Footer */
        .site-footer { background: var(--ink); color: #C9D2D8; }
        .footer-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding-top: 48px; padding-bottom: 48px; font-size: 15px; }
        .footer-brand { display: flex; align-items: center; gap: 12px; }
        .footer-brand img { width: 32px; height: 32px; border-radius: 8px; object-fit: cover; }
        .footer-brand span { font-family: 'Space Grotesk', sans-serif; font-weight: 700; color: #fff; }
        .footer-nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
        .footer-nav a { color: #fff; text-decoration: none; padding: 12px 0; }
        .footer-nav a:hover { color: #F2A66B; }
        .copyright { font-size: 14px; color: #9AA7B0; }

        .menu-toggle { display: none; }

        @media (max-width: 720px) {
            .site-header { position: relative; }
            .menu-toggle {
                display: inline-flex; align-items: center; justify-content: center; gap: 8px;
                min-width: 44px; min-height: 44px; padding: 10px 16px; border-radius: 999px;
                border: 1px solid var(--line); background: #fff; color: var(--ink);
                font: 600 15px Inter, system-ui, sans-serif; cursor: pointer;
            }
            .menu-toggle .icon-close { display: none; }
            .menu-toggle[aria-expanded="true"] .icon-open { display: none; }
            .menu-toggle[aria-expanded="true"] .icon-close { display: block; }
            .main-nav {
                display: none; position: absolute; top: 100%; left: var(--gutter); right: var(--gutter); z-index: 20;
                flex-direction: column; align-items: stretch; gap: 0; padding: 8px;
                background: #fff; border: 1px solid var(--line); border-radius: 20px;
                box-shadow: 0 20px 40px rgba(22, 34, 43, 0.15); font-size: 17px;
            }
            .main-nav.open { display: flex; }
            .main-nav a { padding: 14px 16px; border-radius: 12px; }
            .main-nav a:hover { background: var(--ground); }
            .main-nav .nav-cta { margin-top: 6px; text-align: center; }
        }

        @media (max-width: 600px) {
            .badge-apple { height: 48px; }
            .badge-google { height: 71px; margin: -11.5px -8.5px; }
        }
    </style>
</head>
<body>
    <header class="wrap site-header">
        <a class="brand" href="#top">
            <img src="{{asset 'images/logo.jpeg'}}" alt="">
            <span>Runners Weather</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
            <svg class="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            Menu
        </button>
        <nav id="main-nav" class="main-nav" aria-label="Main">
            <a href="#features">Features</a>
            <a href="#dew-point">Why dew point</a>
            <a href="#platforms">iPhone &amp; Android</a>
            <a class="nav-cta" href="#download">Download</a>
        </nav>
    </header>

    <main>
        <section id="top" class="wrap hero">
            <div class="hero-text">
                <p class="pill"><span class="pill-dot" aria-hidden="true"></span>Now on iPhone and Android</p>
                <h1>Know when to run.<br>And what to wear.</h1>
                <p class="hero-sub">Dew point, wind, rain and feels-like temps, turned into one clear answer for every hour of your day.</p>
                <div id="download" class="badges">
                    <a href="https://apps.apple.com/app/6747822231">
                        <img class="badge-apple" src="{{asset 'images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg'}}" alt="Download on the App Store">
                    </a>
                    <a href="https://play.google.com/store/apps/details?id=com.desseignstudios.runnerweather">
                        <img class="badge-google" src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png" alt="Get it on Google Play">
                    </a>
                </div>
                <p class="hero-note">Free to download · No account needed · No ads</p>
            </div>
            <div class="hero-phone">
                <div class="phone">
                    <img src="{{asset 'images/screenshot1.jpeg'}}" alt="Runners Weather current conditions screen: 94 degrees in Phoenix, dew point 64, sticky, with advice to watch your pace">
                </div>
            </div>
        </section>

        <section id="dew-point" class="dark">
            <div class="wrap section">
                <div class="dew-head">
                    <div>
                        <p class="eyebrow">Why dew point</p>
                        <h2 class="h2">Temperature tells half the story.</h2>
                    </div>
                    <p class="copy">Two 70° mornings can feel nothing alike. Dew point measures the moisture in the air, and it decides how hard your body works to stay cool. Runners Weather colors every hour by it, so you can see a sticky run coming.</p>
                </div>
                <div class="bands">
                    <div class="band" style="background:#CFE3F1"><b>Under 50°</b><span>Comfortable</span></div>
                    <div class="band" style="background:#BFE0C9"><b>50–55°</b><span>Pleasant</span></div>
                    <div class="band" style="background:#F1E3A6"><b>55–60°</b><span>Noticeable</span></div>
                    <div class="band" style="background:#F2B97D"><b>60–65°</b><span>Sticky</span></div>
                    <div class="band light" style="background:#D9643A"><b>65–70°</b><span>Uncomfortable</span></div>
                    <div class="band light" style="background:#8E2B22"><b>70°+</b><span>Oppressive</span></div>
                </div>
                <p class="dew-foot">Dew point in °F. Comfort bands are general guidance; everyone handles humidity differently.</p>
            </div>
        </section>

        <section id="features" class="wrap section">
            <div class="features-head">
                <p class="eyebrow">Features</p>
                <h2 class="h2">Built around the questions runners actually ask.</h2>
            </div>
            <div class="cards">
                <article class="card">
                    <div class="mini mini-blue" aria-hidden="true">
                        <p class="mini-label">YOUR RUN IQ</p>
                        <p class="mini-big">Best: 6–8 AM</p>
                        <div class="bars"><i style="height:30%"></i><i class="best" style="height:92%"></i><i class="best" style="height:100%"></i><i style="height:62%"></i><i style="height:38%"></i><i style="height:24%"></i><i style="height:52%"></i><i style="height:70%"></i></div>
                        <p class="mini-small">52° · dew point 44° · wind 6 mph from the north</p>
                    </div>
                    <h3>When to run</h3>
                    <p>Run IQ scores the next days hour by hour and picks your best window, with a wind tip for which way to head out.</p>
                </article>
                <article class="card">
                    <div class="mini mini-peach" aria-hidden="true">
                        <p class="mini-label">WHAT TO WEAR</p>
                        <div class="wear-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#A8501A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Long-sleeve tech tee</div>
                        <div class="wear-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#A8501A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Shorts</div>
                        <div class="wear-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#A8501A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Light gloves</div>
                        <div class="wear-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#A8501A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Reflective vest after 5 PM</div>
                    </div>
                    <h3>What to wear</h3>
                    <p>Gear for the conditions you will actually run in, day or night, down to reflective gear and a headlamp after dark.</p>
                </article>
                <article class="card">
                    <div class="mini mini-green" aria-hidden="true">
                        <p class="mini-label">HOURLY</p>
                        <div class="hour"><span class="t">6 AM</span><span class="v">52°</span><span class="d"><i class="dot" style="background:#7FB0D4"></i>Dew point 44°</span></div>
                        <div class="hour"><span class="t">8 AM</span><span class="v">55°</span><span class="d"><i class="dot" style="background:#7FB0D4"></i>Dew point 47°</span></div>
                        <div class="hour"><span class="t">12 PM</span><span class="v">64°</span><span class="d"><i class="dot" style="background:#E2C54F"></i>Dew point 56°</span></div>
                        <div class="hour"><span class="t">3 PM</span><span class="v">67°</span><span class="d"><i class="dot" style="background:#E8772E"></i>Dew point 61°</span></div>
                        <div class="hour"><span class="t">6 PM</span><span class="v">60°</span><span class="d"><i class="dot" style="background:#86C39A"></i>Dew point 55°</span></div>
                    </div>
                    <h3>Hour by hour</h3>
                    <p>A runner's forecast: dew point, feels-like, wind and rain chance for every hour, readable at a glance.</p>
                </article>
            </div>
            <div class="extras">
                <div class="extra"><h3>Night mode</h3><p>Icons follow the real sunrise and sunset, and the advice changes once it gets dark.</p></div>
                <div class="extra"><h3>Wind tip</h3><p>Start into the wind and finish with it at your back.</p></div>
                <div class="extra"><h3>Feels-like, done right</h3><p>Heat and humidity together, not just the number on the thermometer.</p></div>
                <div class="extra"><h3>Private by design</h3><p>No account, no ads, no tracking. Just the forecast.</p></div>
            </div>
        </section>

        <section id="platforms" class="platforms-band">
            <div class="wrap section platforms">
                <div class="platforms-text">
                    <p class="eyebrow">iPhone &amp; Android</p>
                    <h2 class="h2">Same honest forecast on both.</h2>
                    <p class="lead">The core of Runners Weather is on both phones. iPhone adds Pro extras like the Coach’s note, Lock Screen widgets, alerts and race-week forecasts for the World Marathon Majors.</p>
                </div>
                <div class="table-box">
                    <table>
                        <thead>
                            <tr><th scope="col">Feature</th><th scope="col">iPhone</th><th scope="col">Android</th></tr>
                        </thead>
                        <tbody>
                            <tr><th scope="row">Run IQ best-time window</th><td>Pro</td><td>Free</td></tr>
                            <tr><th scope="row">What to wear</th><td>Free + Pro</td><td>Free</td></tr>
                            <tr><th scope="row">Hourly dew point forecast</th><td>✓</td><td>✓</td></tr>
                            <tr><th scope="row">Coach’s note (AI run brief)</th><td>Pro</td><td class="no">—</td></tr>
                            <tr><th scope="row">Home-screen widget</th><td>Pro</td><td class="no">—</td></tr>
                            <tr><th scope="row">World Marathon Majors</th><td>Pro</td><td class="no">—</td></tr>
                            <tr><th scope="row">Official weather alerts</th><td>Free</td><td class="no">—</td></tr>
                            <tr><th scope="row">Run window &amp; dew point push alerts</th><td>Pro</td><td class="no">—</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="wrap section">
            <div class="closing">
                <img src="{{asset 'images/logo.jpeg'}}" alt="Runners Weather app icon">
                <h2>Made by a runner, for runners.</h2>
                <div class="badges">
                    <a href="https://apps.apple.com/app/6747822231">
                        <img class="badge-apple" src="{{asset 'images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg'}}" alt="Download on the App Store">
                    </a>
                    <a href="https://play.google.com/store/apps/details?id=com.desseignstudios.runnerweather">
                        <img class="badge-google" src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png" alt="Get it on Google Play">
                    </a>
                </div>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="wrap footer-row">
            <div class="footer-brand">
                <img src="{{asset 'images/logo.jpeg'}}" alt="">
                <span>Runners Weather</span>
            </div>
            <nav class="footer-nav" aria-label="Footer">
                <a href="mailto:info@runnersweather.com">Support</a>
                <a href="/rw-privacy-policy/">Privacy policy</a>
                <a href="https://instagram.com/runnersweather">Instagram</a>
                <a href="https://threads.net/@runnersweather">Threads</a>
                <a href="https://x.com/runners_weather">X</a>
                <a href="https://www.facebook.com/runnersweather/">Facebook</a>
            </nav>
            <p class="copyright">© {{date format="YYYY"}} Desseign Studios</p>
        </div>
    </footer>
    <script>
        (function () {
            var btn = document.querySelector('.menu-toggle');
            var nav = document.getElementById('main-nav');
            if (!btn || !nav) return;
            function setOpen(open) {
                nav.classList.toggle('open', open);
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
            btn.addEventListener('click', function () {
                setOpen(btn.getAttribute('aria-expanded') !== 'true');
            });
            nav.addEventListener('click', function (e) {
                if (e.target.closest('a')) setOpen(false);
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setOpen(false);
            });
            document.addEventListener('click', function (e) {
                if (!nav.contains(e.target) && !btn.contains(e.target)) setOpen(false);
            });
        })();
    </script>
    {{ghost_foot}}
</body>
</html>
